# Copy to backend/.env for local development. Never commit .env.
# In production, set these in the host's dashboard instead.

# --- Django ---------------------------------------------------------------------------------
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true for local development (a dev-only secret key is then used if none is set); false in production.
DJANGO_DEBUG=false
# Comma-separated hostnames that serve the API (production: your backend host, e.g. api.example.com).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Exact frontend origins allowed to call the API (scheme + host + port, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Production behind a TLS-terminating proxy (Render, Railway, Fly.io, …) ------------------
DJANGO_BEHIND_TLS_PROXY=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
# Number of proxies in front of the app, used to read the client IP for throttling. Leave empty
# to use REMOTE_ADDR.
DRF_NUM_PROXIES=

# --- Providers ------------------------------------------------------------------------------
# TomTom Routing + Geocoding key (https://developer.tomtom.com). Server-side only.
TOMTOM_API_KEY=
# Open-Meteo needs no key. Locations per forecast request and cache lifetime (seconds).
WEATHER_BATCH_SIZE=100
WEATHER_CACHE_TTL_S=1800
# Latest allowed departure, in days from now.
MAX_DEPARTURE_DAYS_AHEAD=7
