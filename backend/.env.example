# Copy to backend/.env for local development. Never commit .env.

# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Set to true for local development (a dev-only secret key is then used if none is set).
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Used from later phases (routing and weather). Leave empty until then.
TOMTOM_API_KEY=
WEATHER_BATCH_SIZE=100
WEATHER_CACHE_TTL_S=1800
MAX_DEPARTURE_DAYS_AHEAD=7
